@startuml Meeting_Scheduling_Sequence
!theme plain
skinparam sequence {
    ArrowColor #333333
    ActorBackgroundColor #FFFFFF
    ActorBorderColor #333333
    ParticipantBackgroundColor #F3E5F5
    ParticipantBorderColor #512DA8
    LifeLineBackgroundColor #FFFFFF
    LifeLineBorderColor #333333
}

actor "Chef/Admin" as Chef
participant "React Form" as Form
participant "MeetingController" as MeetCtrl
database "MySQL DB" as DB
participant "Notification\nService" as NotifSvc
participant "Email Service" as EmailSvc
participant "Calendar\nIntegration" as Calendar

Chef -> Form: Opens meeting schedule form
activate Form

Chef -> Form: Enters meeting details\n(date, time, chef_id, location, description)

Form -> MeetCtrl: POST /api/meetings\n{scheduled_at, chef_id, location, description}
activate MeetCtrl

MeetCtrl -> MeetCtrl: Validate meeting data\n(datetime, timezone, permissions)
alt Validation Error
    MeetCtrl -> Form: 422 Unprocessable Entity\n{errors: [...]}
    deactivate MeetCtrl
    Form -> Chef: Display error messages
    deactivate Form
else Validation Success
    MeetCtrl -> DB: BEGIN TRANSACTION\nINSERT meetings table
    activate DB
    DB -> DB: Generate meeting_id\nSet timestamp = NOW()
    DB -> MeetCtrl: meeting_id, scheduled_at, created_at
    deactivate DB

    MeetCtrl -> NotifSvc: POST /notify-meeting (async)\n{meeting_id, chef_id, scheduled_at}
    activate NotifSvc

    MeetCtrl -> Calendar: POST /sync-calendar\n{meeting_id, chef_id, details}
    activate Calendar
    Calendar -> Calendar: Add event to calendar\nwith timestamp & details
    Calendar -> MeetCtrl: calendar_event_id, synced_at
    deactivate Calendar

    MeetCtrl -> Form: 201 Created\n{meeting_id, scheduled_at, chef_id, location}
    deactivate MeetCtrl

    Form -> Chef: Show confirmation\n"Meeting scheduled for [timestamp]"
    deactivate Form

    par Send Notifications
        NotifSvc -> DB: INSERT notifications table\n{chef_id, meeting_id, type: 'meeting_scheduled'}
        activate DB
        DB -> NotifSvc: notification_id
        deactivate DB

        NotifSvc -> EmailSvc: Queue email task\n(chef_email, meeting details, timestamp)
        activate EmailSvc
        EmailSvc -> EmailSvc: Render email template\nwith meeting time & details
        EmailSvc -> Chef: Send email notification\n(Subject: "Meeting Scheduled")
        deactivate EmailSvc

        NotifSvc -> Chef: In-app notification badge
        deactivate NotifSvc
    end

    Chef -> Calendar: Meeting appears in\nchef's calendar view
end
@enduml
