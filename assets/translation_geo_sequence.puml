@startuml Translation_Geolocation_Sequence
!theme plain
skinparam sequence {
    ArrowColor #333333
    ActorBackgroundColor #FFFFFF
    ActorBorderColor #333333
    ParticipantBackgroundColor #FFF3E0
    ParticipantBorderColor #E65100
    LifeLineBackgroundColor #FFFFFF
    LifeLineBorderColor #333333
}

actor "Public User" as User
participant "React Frontend\n(i18n)" as Frontend
participant "TranslationController" as TransCtrl
database "MySQL DB" as DB
participant "GeoLocation\nService" as GeoSvc
participant "Partnership\nFilter" as Filter

User -> Frontend: Opens public portfolio page
activate Frontend

User -> Frontend: Change language dropdown\nto French (fr)
activate User

Frontend -> TransCtrl: GET /api/translations?lang=fr
activate TransCtrl

TransCtrl -> DB: SELECT * FROM translations\nWHERE language_code='fr'
activate DB
DB -> DB: Fetch all French translation keys\n& values (cached with 24h TTL)
DB -> TransCtrl: {key1: 'valeur1', key2: 'valeur2', ...}
deactivate DB

TransCtrl -> Frontend: 200 OK\n{language: 'fr', translations: {...},\ndirection: 'ltr', locale_date_format}
deactivate TransCtrl

Frontend -> Frontend: Update i18n state\nswitch locale to 'fr'
Frontend -> Frontend: Re-render entire UI\nwith French strings
Frontend -> User: Display page in French\n(all labels, buttons, descriptions)
deactivate User
deactivate Frontend

note over User: User enables location filtering

User -> Frontend: Clicks "Filter by my location"
activate Frontend

Frontend -> GeoSvc: Request browser geolocation\n(navigator.geolocation.getCurrentPosition)
activate GeoSvc
GeoSvc -> GeoSvc: Browser permission dialog
GeoSvc -> GeoSvc: Get user latitude, longitude,\naccuracy
GeoSvc -> Frontend: {lat, lng, country, timezone}
deactivate GeoSvc

Frontend -> Filter: Apply location-based filter
activate Filter

alt User Selected French Before
    Filter -> TransCtrl: POST /api/partnerships/filter?lang=fr\n{latitude, longitude, radius_km, sort}
else User Selected Other Language
    Filter -> TransCtrl: POST /api/partnerships/filter?lang={lang}\n{latitude, longitude, radius_km, sort}
end
activate TransCtrl

TransCtrl -> TransCtrl: Calculate distance matrix\nfrom user location

TransCtrl -> DB: SELECT partnerships\nWHERE country_code IN \n(extracted from geolocation)\nORDER BY distance ASC
activate DB
DB -> DB: Query partnerships within\nuser's country/region\n(with distance calculation)
DB -> TransCtrl: Filtered partnerships\n{id, name, logo_url, country, distance_km}
deactivate DB

alt Arabic Language Detected
    TransCtrl -> TransCtrl: Format response with\ndirection='rtl'\n(right-to-left text)
    TransCtrl -> Frontend: 200 OK\n{partnerships: [...], direction: 'rtl',\nlanguage: 'ar', locale_format: 'ar-AE'}
else Other Language
    TransCtrl -> Frontend: 200 OK\n{partnerships: [...], direction: 'ltr',\nlanguage: lang_code, locale_format: ...}
end
deactivate TransCtrl

Filter -> Frontend: Render filtered partnerships
deactivate Filter

Frontend -> Frontend: Apply CSS direction\n(dir='rtl' or 'ltr')\nif Arabic language\nAdjust layout, text-align, margins

Frontend -> User: Display geo-filtered partnerships\nin selected language\n(French/Arabic/etc.)\nSorted by distance from user location
deactivate Frontend

User -> User: Browse filtered results\nclick partnership link\n(same as partnership click flow)
@enduml
